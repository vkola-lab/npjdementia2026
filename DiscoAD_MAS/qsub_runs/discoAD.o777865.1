    print("Error: The file './working/filtered_dataset.csv' was not found.")
    raise
except Exception as e:
    print(f"Error loading the dataset: {e}")
    raise

# Focus on the hypothesis: "Higher age is associated with increased dementia incidence"
age_column = 'Subjects_age_at_visit'
dementia_column = 'Met_criteria_for_dementia'

# Ensure both columns have valid data (no NaNs)
df_filtered = df.dropna(subset=[age_column, dementia_column])
print(f"After removing NaNs in age and dementia status: {df_filtered.shape[0]} rows remain.")

# Descriptive statistics for age by dementia status
print("\n--- Age Distribution by Dementia Status ---")
age_by_dementia = df_filtered.groupby(dementia_column)[age_column].agg(['mean', 'std', 'count'])
print(age_by_dementia)

# Perform independent two-sample t-test (unequal variances)
try:
    age_with_dementia = df_filtered[df_filtered[dementia_column] == 1][age_column]
    age_without_dementia = df_filtered[df_filtered[dementia_column] == 0][age_column]
    
    t_stat, p_value = stats.ttest_ind(age_with_dementia, age_without_dementia, equal_var=False)
    
    # Effect size via Cohen's d
    mean1 = age_with_dementia.mean()
    mean0 = age_without_dementia.mean()
    std1 = age_with_dementia.std()
    std0 = age_without_dementia.std()
    n1, n0 = len(age_with_dementia), len(age_without_dementia)
    
    pooled_std = np.sqrt(((n1 - 1) * std1**2 + (n0 - 1) * std0**2) / (n1 + n0 - 2))
    cohens_d = (mean1 - mean0) / pooled_std
    
    print(f"\n--- Hypothesis Testing Results ---")
    print(f"T-statistic: {t_stat:.4f}, P-value: {p_value:.4f}")
    print(f"Cohen's d (effect size): {cohens_d:.3f}")
    
    # Interpret effect size
    if abs(cohens_d) < 0.2:
        effect_size_interp = "Small"
    elif abs(cohens_d) < 0.5:
        effect_size_interp = "Medium"
    else:
        effect_size_interp = "Large"
        
    print(f"Effect Size Interpretation: {effect_size_interp}")
    
except Exception as e:
    print(f"Error performing t-test: {e}")

# Final conclusion
print("\n--- Conclusion ---")
if p_value < 0.05:
    print("The evidence suggests that higher age is significantly associated with increased dementia incidence.")
else:
    print("No statistically significant association was found between age and dementia incidence.")
